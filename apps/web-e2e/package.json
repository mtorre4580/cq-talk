{
  "name": "@cq-talk/web-e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:e2e",
      "scope:web"
    ],
    "implicitDependencies": [
      "@cq-talk/web"
    ],
    "targets": {
      "typecheck": {
        "command": "tsc -p tsconfig.json",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true,
        "inputs": [
          "default",
          "^production"
        ]
      },
      "e2e": {
        "dependsOn": [
          {
            "projects": [
              "@cq-talk/web"
            ],
            "target": "build"
          }
        ]
      }
    }
  }
}
