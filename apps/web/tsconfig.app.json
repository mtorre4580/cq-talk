    },
    {
      "path": "../../libs/qso/tsconfig.lib.json"
    },
    {
      "path": "../../libs/platform/tsconfig.lib.json"
    },
    {
      "path": "../../libs/i18n/tsconfig.lib.json"
    },
    {
      "path": "../../libs/claude/tsconfig.lib.json"
    },
    {
      "path": "../../libs/features/call/tsconfig.lib.json"
