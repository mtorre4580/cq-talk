{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out-tsc/lib",
    "tsBuildInfoFile": "out-tsc/lib/tsconfig.lib.tsbuildinfo",
    "rootDir": "src",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test-setup.ts", "src/test/**"],
  "references": [
    {
      "path": "../../storage/tsconfig.lib.json"
    },
    {
      "path": "../../speech/tsconfig.lib.json"
    },
    {
      "path": "../../i18n/tsconfig.lib.json"
    },
    {
      "path": "../../claude/tsconfig.lib.json"
    },
    {
      "path": "../../audio/tsconfig.lib.json"
    }
  ]
}
